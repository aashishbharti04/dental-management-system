# ----------------------------------------------------------------------------
# Dental Management System — environment configuration
#
# Copy this file to `.env` and fill in real values. NEVER commit your `.env`.
#   cp .env.example .env
# ----------------------------------------------------------------------------

# --- Database (MySQL) --------------------------------------------------------
# These match the original project's MySQL setup, but are now configurable.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=dental_management_system
# Max connections in the pool.
DB_CONNECTION_LIMIT=10

# --- Authentication ----------------------------------------------------------
# Secret used to sign session JWTs. Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Session lifetime in seconds (default: 8 hours).
SESSION_MAX_AGE=28800

# --- First admin account (used by `npm run db:seed`) -------------------------
# Creates the initial login account. Equivalent to the old ACCOUNT ADDITION.py.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# --- App ---------------------------------------------------------------------
# Public site URL (used for SEO metadata, sitemap and Open Graph tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
