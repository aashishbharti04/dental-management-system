{
  "name": "dental-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "A modern, secure, open-source dental clinic management system built with Next.js, TypeScript, Tailwind CSS, and MySQL.",
  "author": "Aashish Bharti <aashish@marketdoctorsonline.com>",
  "license": "MIT",
  "homepage": "https://github.com/aashishbharti04/dental-management-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aashishbharti04/dental-management-system.git"
  },
  "bugs": {
    "url": "https://github.com/aashishbharti04/dental-management-system/issues"
  },
  "keywords": [
    "dental",
    "clinic",
    "management-system",
    "healthcare",
    "nextjs",
    "typescript",
    "tailwindcss",
    "mysql",
    "open-source"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "jose": "^5.9.6",
    "lucide-react": "^0.456.0",
    "mysql2": "^3.11.4",
    "next": "^14.2.18",
    "next-themes": "^0.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
